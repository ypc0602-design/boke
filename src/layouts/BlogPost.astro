---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { path } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main class="post-layout">
			<article class="post-content">
				<header class="post-header">
					<div class="post-meta">
						<time datetime={pubDate.toISOString()}>
							<FormattedDate date={pubDate} />
						</time>
						{updatedDate && (
							<span class="last-updated-on">
								更新于 <FormattedDate date={updatedDate} />
							</span>
						)}
					</div>
					<h1>{title}</h1>
					{description && <p class="post-summary">{description}</p>}
				</header>

				{heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt="" />
					</div>
				)}

				<!-- 正文（Astro 内置 Shiki 代码高亮） -->
				<div class="prose">
					<slot />
				</div>

				<!-- 文章尾部 -->
				<footer class="post-footer">
					<a href={path('/blog/')} class="back-link">← 返回博客列表</a>
				</footer>
			</article>

			<!-- 目录（TOC）侧栏 -->
			<nav class="toc" aria-label="文章目录">
				<div class="toc-inner">
					<div class="toc-title">目录</div>
					<ul class="toc-list" id="toc-list"></ul>
				</div>
			</nav>
		</main>

		<div id="lightbox" class="lightbox" hidden>
			<img id="lightbox-img" src="" alt="图片预览" />
		</div>

		<button id="back-to-top" class="back-to-top" aria-label="回到顶部" title="回到顶部">↑</button>

		<Footer />

		<script>
			/* ---------- 目录生成（从渲染出的标题提取） ---------- */
			const tocList = document.getElementById('toc-list');
			if (tocList) {
				const headings = document.querySelectorAll(
					'.prose h2, .prose h3, .prose h4',
				);
				const stack = [];

				headings.forEach((h, index) => {
					// 为标题补 id（若缺失），供锚点定位
					if (!h.id) {
						h.id = 'heading-' + index;
					}
					const level = Number(h.tagName[1]);
					const link = document.createElement('a');
					link.href = '#' + h.id;
					link.textContent = h.textContent;
					link.addEventListener('click', (e) => {
						e.preventDefault();
						history.pushState(null, '', '#' + h.id);
						h.scrollIntoView({ behavior: 'smooth', block: 'start' });
					});

					// 用缩进模拟层级（简单可靠）
					const li = document.createElement('li');
					li.classList.add('toc-level-' + level);
					li.appendChild(link);
					tocList.appendChild(li);
				});

				if (headings.length === 0) {
					tocList.innerHTML = '<li class="toc-empty">本文暂无目录</li>';
				}

				// 滚动高亮当前标题
				const tocLinks = tocList.querySelectorAll('a');
				const sectionObs = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								tocLinks.forEach((l) => l.classList.remove('active'));
								const id = entry.target.id;
								tocLinks.forEach((l) =>
									l.href.endsWith('#' + id) ? l.classList.add('active') : null,
								);
							}
						});
					},
					{ rootMargin: '0px 0px -70% 0px' },
				);
				headings.forEach((h) => sectionObs.observe(h));
			}

			/* ---------- 图片灯箱 ---------- */
			const lightbox = document.getElementById('lightbox');
			const lightboxImg = document.getElementById('lightbox-img');
			if (lightbox && lightboxImg) {
				document.querySelectorAll('.prose img').forEach((img) => {
					img.style.cursor = 'zoom-in';
					img.addEventListener('click', () => {
						lightboxImg.src = img.src;
						lightbox.hidden = false;
						document.body.style.overflow = 'hidden';
					});
				});
				lightbox.addEventListener('click', () => {
					lightbox.hidden = true;
					document.body.style.overflow = '';
				});
			}

			/* ---------- 回到顶部 ---------- */
			const backToTop = document.getElementById('back-to-top');
			if (backToTop) {
				window.addEventListener(
					'scroll',
					() => {
						backToTop.classList.toggle('show', window.scrollY > 400);
					},
					{ passive: true },
				);
				backToTop.addEventListener('click', () => {
					window.scrollTo({ top: 0, behavior: 'smooth' });
				});
			}
		</script>
	</body>
</html>

<style>
	/* ---- 布局：正文 + 右侧目录 ---- */
	.post-layout {
		display: grid;
		grid-template-columns: 1fr 250px;
		gap: 2.5em;
		max-width: calc(var(--content-width) + 280px);
	}
	.post-content {
		min-width: 0;
	}

	.post-header {
		margin-bottom: 1.8em;
		text-align: center;
	}
	.post-header h1 {
		font-size: 2em;
		margin: 0.3em 0 0.5em;
		line-height: 1.3;
	}
	.post-meta {
		color: rgb(var(--text-light));
		font-size: 0.88em;
		margin: 0;
	}
	.last-updated-on {
		margin-left: 0.8em;
		font-style: italic;
	}
	.post-summary {
		color: rgb(var(--text-light));
		font-size: 1em;
		max-width: 60ch;
		margin: 0 auto;
	}

	.hero-image {
		margin-bottom: 2em;
	}
	.hero-image img {
		display: block;
		margin: 0 auto;
		border-radius: var(--radius);
		box-shadow: var(--box-shadow);
	}

	/* 正文 */
	.prose {
		font-size: 1em;
		line-height: 1.9;
	}
	.prose img {
		display: block;
		margin: 1em auto;
	}
	.prose ul,
	.prose ol {
		padding-left: 1.6em;
		margin-bottom: 1.2em;
	}
	.prose li {
		margin-bottom: 0.4em;
	}

	/* 文章尾部 */
	.post-footer {
		margin-top: 3em;
		padding-top: 1.5em;
		border-top: 1px solid rgb(var(--border));
	}
	.back-link {
		color: rgb(var(--text-light));
		font-size: 0.95em;
	}
	.back-link:hover {
		color: var(--accent);
		text-decoration: none;
	}

	/* ---- 目录侧栏 ---- */
	.toc {
		position: sticky;
		top: calc(var(--header-height) + 24px);
		align-self: start;
		max-height: calc(100vh - var(--header-height) - 48px);
		overflow-y: auto;
		font-size: 0.88em;
		padding-left: 0.4em;
	}
	.toc-title {
		font-weight: 700;
		color: rgb(var(--text));
		margin-bottom: 0.6em;
		font-size: 1em;
	}
	.toc-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.3em;
	}
	.toc-list li {
		line-height: 1.5;
	}
	.toc-list a {
		display: block;
		padding: 0.2em 0.4em;
		border-left: 2px solid rgb(var(--border));
		color: rgb(var(--text-light));
		text-decoration: none;
		transition: all 0.2s ease;
	}
	.toc-list a:hover {
		color: var(--accent);
		border-left-color: var(--accent);
		text-decoration: none;
	}
	.toc-list a.active {
		color: var(--accent);
		border-left-color: var(--accent);
		font-weight: 600;
	}
	.toc-level-3 a {
		padding-left: 1.1em;
	}
	.toc-level-4 a {
		padding-left: 1.9em;
	}
	.toc-empty {
		color: rgb(var(--text-light));
		font-size: 0.9em;
	}

	/* ---- 灯箱 ---- */
	.lightbox {
		position: fixed;
		inset: 0;
		z-index: 999;
		background: rgba(0, 0, 0, 0.85);
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: zoom-out;
		padding: 2em;
	}
	.lightbox img {
		max-width: 100%;
		max-height: 90vh;
		border-radius: 6px;
		box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
	}
	.lightbox[hidden] {
		display: none;
	}

	/* ---- 回到顶部 ---- */
	.back-to-top {
		position: fixed;
		right: 24px;
		bottom: 24px;
		width: 44px;
		height: 44px;
		border: 1px solid rgb(var(--border));
		border-radius: 50%;
		background: var(--bg-card);
		color: rgb(var(--text));
		font-size: 1.05em;
		cursor: pointer;
		box-shadow: var(--box-shadow);
		opacity: 0;
		visibility: hidden;
		transform: translateY(8px);
		transition:
			opacity 0.25s,
			visibility 0.25s,
			transform 0.25s,
			background-color 0.3s ease;
		z-index: 90;
	}
	.back-to-top.show {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}
	.back-to-top:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	/* ---- 移动端：目录收起到顶部横向条 ---- */
	@media (max-width: 980px) {
		.post-layout {
			grid-template-columns: 1fr;
		}
		.toc {
			display: none;
		}
	}
</style>